AREVIK_ENV=development
AREVIK_HOST=0.0.0.0
AREVIK_PORT=8000

# CPU-first STT
AREVIK_STT_MODEL=small
AREVIK_STT_COMPUTE_TYPE=int8
AREVIK_STT_CPU_THREADS=4

# Local translation models
AREVIK_TRANSLATION_EN_HY=Helsinki-NLP/opus-mt-en-hy
AREVIK_TRANSLATION_HY_EN=Helsinki-NLP/opus-mt-hy-en

# Baseline local TTS
AREVIK_TTS_ENGINE=espeak
AREVIK_TTS_RATE=165

# Runtime
AREVIK_TEMP_DIR=/tmp/arevik
